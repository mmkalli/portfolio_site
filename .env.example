OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Comma-separated optional fallback model IDs. Review pricing before enabling.
OPENROUTER_FALLBACK_MODELS=
# The selected free model requires "allow". Use "deny" only with a compatible provider.
OPENROUTER_DATA_COLLECTION=allow
# Required for production metadata, canonical URLs, same-origin checks, and OpenRouter attribution.
SITE_URL=http://localhost:3000
