    "check": "npm run lint && npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.136",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.133",
    "next": "^16.4.0",
